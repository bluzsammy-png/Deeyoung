<?xml version="1.0" encoding="utf-8"?>
<!-- Session tokens live in EncryptedSharedPreferences and must never leave
     the device through cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
