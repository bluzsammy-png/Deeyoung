*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# local sqlite (sandbox dev only — production is Supabase Postgres)
/db
*.db
*.db-journal

# local verification screenshots
verify-*.png

# sandbox/local artifacts — never publish
/.zscripts/
/Caddyfile
/audit/
/download/
/examples/
/mini-services/
/scripts/
/tests/
/tool-results/
/upload/
/worklog.md
/dev.log
/server.log
verify-*.png

# large media served from public (kit files live in download/)
public/*.mp4

# dev-only sandbox helper (reaper escape hatch) — never deploy, never commit
src/app/api/dev-pair/
