// QUANTEDGE PRO — Core Data Model (Phase 1 Foundation)
// SQLite for sandbox parity; schema is portable to PostgreSQL (Supabase/Neon) per audit decision D8.
// JSON fields are stored as strings for SQLite portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & Tenancy ───────────────────────────────────────────────────────

model User {
  id               String   @id
  email            String   @unique
  emailVerified    Boolean  @default(false)
  name             String?
  image            String?
  role             String   @default("USER") // USER | SUPPORT | ANALYST | ADMIN | SUPER_ADMIN
  // ── Subscription & trust state (billing/anti-abuse layer) ──
  status           String   @default("ACTIVE") // ACTIVE | WARNED | SUSPENDED | BANNED
  plan             String   @default("TRIAL") // TRIAL | FREE | PREMIUM
  trialEndsAt      DateTime?
  ipHash           String?  // HMAC-SHA256 of signup IP (GDPR-safe, never raw IP)
  experience       String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  interests        String   @default("[]") // JSON: ["STOCKS","ETFS","CRYPTO"]
  goals            String   @default("[]") // JSON: ["LEARN","ANALYZE","OPPORTUNITIES","PAPER_TRADE","AUTOMATE"]
  onboarded        Boolean  @default(false)
  presentationMode String   @default("SIMPLE") // SIMPLE | ADVANCED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  account         PaperAccount?
  positions       Position[]
  orders          Order[]
  signals         SignalRecord[]
  sentinelConfig  SentinelConfig?
  approvals       Approval[]
  watchlist       WatchlistItem[]
  strategies      Strategy[]
  backtests       BacktestRun[]
  notifications   NotificationRecord[]
  auditEvents     AuditEvent[]
  usageEvents     UsageEvent[]
  sessions        UserSession[]

  // Better Auth relations
  authSessions    Session[]
  authAccounts    Account[]
  warnings        Warning[]
  links        BrokerLink[]
  billingOrders   BillingOrder[]
}

// ─── Better Auth (better-auth.com) ───────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Anti-abuse & moderation ─────────────────────────────────────────────────

// Signup velocity tracking: N signups per hashed IP per 24h window
model SignupAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  email     String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// Moderation ladder: WARN → SUSPEND → BAN (with appeals via support)
model Warning {
  id             String    @id @default(cuid())
  userId         String
  reason         String
  message        String    @default("")
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  userAgent String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Paper Brokerage ──────────────────────────────────────────────────────────

model PaperAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  broker          String   @default("QUANTEDGE_SIM") // QUANTEDGE_SIM | ALPACA_PAPER
  cash            Float    @default(100000)
  startingCash    Float    @default(100000)
  equitySnapshot  String   @default("[]") // JSON: [{t, equity}]
  realizedPnl     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Position {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  assetClass String   @default("EQUITY") // EQUITY | ETF | CRYPTO (schema-ready per D6)
  sector     String   @default("UNKNOWN")
  qty        Float
  avgPrice   Float
  stop       Float?
  target     Float?
  openedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
}

model Order {
  id           String    @id @default(cuid())
  userId       String
  requestId    String    @unique // idempotency key (§59)
  symbol       String
  assetClass   String    @default("EQUITY")
  side         String // BUY | SELL
  type         String    @default("MARKET") // MARKET | LIMIT | STOP
  qty          Float
  limitPrice   Float?
  stopPrice    Float?
  status       String    @default("PENDING") // PENDING | FILLED | PARTIAL | REJECTED | CANCELLED
  filledQty    Float     @default(0)
  avgFillPrice Float?
  rejectReason String?
  source       String    @default("MANUAL") // MANUAL | SENTINEL
  approvalId   String?
  fills        String    @default("[]") // JSON: [{t, qty, price, slippageBps}]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  filledAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─── Signal & Research ────────────────────────────────────────────────────────

model SignalRecord {
  id              String    @id @default(cuid())
  userId          String? // null = platform-wide signal
  symbol          String
  assetClass      String    @default("EQUITY")
  direction       String // LONG | SHORT
  score           Float
  factors         String // JSON: [{name, contribution, max, detail}]
  entry           Float
  stop            Float
  target          Float
  rr              Float
  regime          String
  catalystScore   Float     @default(0)
  horizon         String? // M10 | M30 (learning memory attribution)
  status          String    @default("OPEN") // OPEN | TARGET_HIT | STOP_HIT | EXPIRED | CANCELLED
  resultPct       Float?
  openedAt        DateTime  @default(now())
  resolvedAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([symbol, status])
  @@index([userId, openedAt])
}

// ─── SENTINEL ─────────────────────────────────────────────────────────────────

model SentinelConfig {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  mode                     String   @default("OBSERVE") // OBSERVE | APPROVE | DELEGATE (default Observe §7/§16)
  state                    String   @default("ACTIVE") // ACTIVE PAUSED WAITING_FOR_APPROVAL RISK_LOCKED BROKER_DISCONNECTED DATA_UNAVAILABLE NEWS_PROVIDER_UNAVAILABLE SYSTEM_DEGRADED EMERGENCY_STOP (§17)
  riskPerTradePct          Float    @default(1.0)
  maxPositionPct           Float    @default(20)
  maxNotionalUsd           Float    @default(25000)
  maxOpenPositions         Int      @default(8)
  maxDailyLossPct          Float    @default(3)
  maxWeeklyLossPct         Float    @default(8)
  maxDailyTrades           Int      @default(10)
  minRR                    Float    @default(1.5)
  minSignalScore           Float    @default(70)
  signalHorizon            String   @default("M30") // M10 | M30 — horizon-aware scoring (campaign-validated chase-guard + M30 momentum bonus)
  minLiquidityUsd          Float    @default(5000000)
  maxSpreadBps             Float    @default(15)
  maxCorrelatedExposurePct Float    @default(35)
  maxPortfolioDrawdownPct  Float    @default(15)
  allowedAssets            String   @default("[\"EQUITY\",\"ETF\"]")
  allowedStrategies        String   @default("[\"MOMENTUM_BREAKOUT\",\"TREND_PULLBACK\"]")
  allowedSessions          String   @default("[\"REGULAR\"]") // REGULAR | PRE | POST
  autoPauseOnDataStale     Boolean  @default(true)
  killSwitch               Boolean  @default(false)
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Approval {
  id         String    @id @default(cuid())
  userId     String
  symbol     String
  side       String
  qty        Float
  entry      Float
  stop       Float
  target     Float
  riskUsd    Float
  rr         Float
  score      Float
  regime     String
  catalyst   String?
  riskChecks String // JSON: [{name, pass, detail}]
  proposal   String    @default("{}")
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  expiresAt  DateTime // time-limited (§16)
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─── Watchlist / Notifications / Audit / Usage ────────────────────────────────

model WatchlistItem {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  assetClass String   @default("EQUITY")
  addedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model NotificationRecord {
  id          String    @id @default(cuid())
  userId      String
  event       String // SIGNAL_HIGH_CONFIDENCE | SENTINEL_APPROVAL_REQUEST | TRADE_EXECUTED | STOP_HIT | TARGET_HIT | RISK_LIMIT | BROKER_DISCONNECTED | MAJOR_CATALYST | SYSTEM_DEGRADED | ACCOUNT_SECURITY (§25)
  title       String
  body        String
  importance  String    @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  channels    String    @default("[\"WEB\"]")
  status      String    @default("QUEUED") // QUEUED | SENT | DELIVERED | OPENED | FAILED
  attempts    Int       @default(0)
  deepLink    String? // in-app deep link (§25)
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  category  String // AUTH | SETTINGS | RISK | SENTINEL | APPROVAL | ORDER | FILL | BROKER | API_KEY | SUBSCRIPTION | EMERGENCY_STOP | ADMIN (§45)
  action    String
  detail    String   @default("{}")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([category, createdAt])
}

model UsageEvent {
  id         String   @id @default(cuid())
  userId     String?
  provider   String // YAHOO | FINNHUB | ALPACA | ZAI_AI (§31)
  service    String // MARKET_DATA | NEWS | AI_CALL | BACKTEST | NOTIFICATION
  units      Float    @default(1)
  estCostUsd Float    @default(0)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
}

// ─── Strategy Lab ─────────────────────────────────────────────────────────────

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  kind        String   @default("MOMENTUM_BREAKOUT")
  params      String   @default("{}")
  version     Int      @default(1)
  parentStrategyId String?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BacktestRun {
  id          String   @id @default(cuid())
  userId      String
  strategyId  String?
  symbol      String
  timeframe   String   @default("1d")
  rangeMonths Int      @default(12)
  params      String   @default("{}")
  metrics     String   @default("{}") // JSON metrics block (§21)
  equityCurve String   @default("[]")
  trades      String   @default("[]")
  warnings    String   @default("[]") // bias warnings surfaced to user
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── System Health ────────────────────────────────────────────────────────────

model SystemEvent {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO | WARN | ERROR
  source    String // MARKET_DATA | NEWS | AI | DATABASE | BROKER | NOTIFICATIONS | WORKER
  message   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// ─── Broker Links (MT4/MT5 connectivity, §60) ─────────────────────────────────
// Credentials are stored AES-256-GCM encrypted with APP_SECRET. INVESTOR mode
// (read-only) is the recommended link type; live order routing stays gated
// behind the broker bridge and is never enabled by this schema alone.

model BrokerLink {
  id             String   @id @default(cuid())
  userId         String
  platform       String   // MT4 | MT5
  label          String   // user-friendly name, e.g. "IC Markets MT5"
  server         String   // broker server name as shown in the terminal
  login          String   // account number (not a secret by itself)
  credCipher     String   // AES-256-GCM ciphertext of the account password
  credIV         String   // GCM initialization vector (hex)
  credTag        String   // GCM auth tag (hex)
  mode           String   @default("INVESTOR") // INVESTOR (read-only) | FULL
  status         String   @default("PENDING_BRIDGE") // PENDING_BRIDGE | CONNECTED | ERROR
  statusDetail   String   @default("")
  currency       String   @default("USD")
  balance        Float?   // last known balance via bridge
  equity         Float?   // last known equity via bridge
  lastCheckedAt  DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── LEARNING MEMORY (§NEW) ───────────────────────────────────────────────────
model BrainMemory {
  id        String   @id @default(cuid())
  scope     String   @unique
  stateJson String
  updatedAt DateTime @updatedAt
}
// ─── OWN PAPER TRADING ENGINE (2026-09-04) ────────────────────────────────────
// Run-scoped execution-of-record for the autonomous bot (no User relation).
// Every fill derives from a real observed market price at a real timestamp —
// never invented. Auditable from /api/engine/status.

model EngineRun {
  id        String   @id @default(cuid())
  label     String   @unique
  status    String   @default("ACTIVE") // ACTIVE | STOPPED
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   PaperEngineAccount?
  orders    PaperEngineOrder[]
  positions PaperEnginePosition[]
}

model PaperEngineAccount {
  id          String   @id @default(cuid())
  runId       String   @unique
  cashUsd     Float    @default(10000)
  startingUsd Float    @default(10000)
  realizedPnl Float    @default(0)
  feesUsd     Float    @default(0)
  peakEquity  Float    @default(10000)
  maxDdPct    Float    @default(0)
  dayKey      String?
  dayPnlR     Float    @default(0)
  equityCurve String   @default("[]")
  updatedAt   DateTime @updatedAt

  run EngineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model PaperEngineOrder {
  id           String    @id @default(cuid())
  runId        String
  clientOid    String    @unique
  bookKey      String
  symbol       String
  side         String
  kind         String    @default("ENTRY")
  refPrice     Float
  fillPrice    Float?
  slippageBps  Float?
  feeUsd       Float?
  qty          Float?
  notionalUsd  Float?
  status       String    @default("FILLED")
  rejectReason String?
  positionId   String?
  createdAt    DateTime  @default(now())
  filledAt     DateTime?

  run EngineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model PaperEnginePosition {
  id          String    @id @default(cuid())
  runId       String
  bookKey     String
  symbol      String
  gate        Int
  horizonMin  Int
  side        String    @default("LONG")
  qty         Float
  entryPrice  Float
  stopPrice   Float
  targetPrice Float
  atrPct      Float
  score       Float
  rr          Float
  notionalUsd Float
  factors     String    @default("[]")
  status      String    @default("OPEN")
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  exitPrice   Float?
  exitReason  String?
  grossPnlUsd Float?
  netPnlUsd   Float?
  netR        Float?

  run EngineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([bookKey, status])
}

// DEEYOUNG PRO — live-venue mirror ledger (2026-09-04 "go" build).
// One row per REAL order fired at an external venue (OKX demo/live) mirroring
// a paper-engine fill. Paper ledger stays the execution-of-record; this table
// is the honest audit trail of what the venue actually received/filled.
model VenueMirrorOrder {
  id         String    @id @default(cuid())
  clientOid  String    @unique // engine order id (E_…/X_…) — the paper side
  clOrdId    String    @unique // derived venue-safe id actually sent to OKX
  venue      String // okx-demo | okx-live
  instId     String // BTC-USDT
  symbol     String // engine symbol (BTCUSD)
  side       String // BUY | SELL
  kind       String // ENTRY | EXIT_STOP | EXIT_TARGET | EXIT_TIME_10M | EXIT_TIME_30M | RISK_FLAT
  refPrice   Float // observed market price at submission
  sz         Float? // requested size (quote ccy for spot market BUY, base ccy for SELL)
  venueOrdId String?
  exitFor    String? // for SELL rows: clientOid of the BUY row this closes
  state      String    @default("SUBMITTED") // SUBMITTED | LIVE | FILLED | CANCELED | FAILED
  fillPx     Float?
  fillSz     Float?
  feeCost    Float?
  slipBps    Float?
  alert      String?
  raw        String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([venue, createdAt])
  @@index([state])
  @@index([symbol, side, state])
}

// DEEYOUNG PRO — runtime engine control (admin console lever).
// Singleton row: paused = no NEW entries; open positions are ALWAYS still
// managed to their exits (stop/target/time) regardless of this flag.
model EngineControl {
  id        String   @id @default("singleton")
  paused    Boolean  @default(false)
  reason    String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// DEEYOUNG PRO — in-house live support chat (free, zero third-party).
// Visitors post under an anonymous threadKey (localStorage token — no email
// required to ask a question); the owner replies from the /admin Support tab.
// role: VISITOR = from the site widget, AGENT = from the admin console.
// seen: for VISITOR rows = admin has read it; for AGENT rows = visitor has read it.
model SupportMessage {
  id          String   @id @default(cuid())
  threadKey   String
  role        String
  body        String
  visitorName String?
  page        String?
  ipHash      String?
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([threadKey, createdAt])
  @@index([seen, createdAt])
}

// DEEYOUNG PRO — subscription orders (hosted checkout or manual verification).
// Mirror of the postgres model; see schema.postgres.prisma for the full doc.
model BillingOrder {
  id        String    @id @default(cuid())
  userId    String
  tier      String // STARTER | PRO | ELITE
  currency  String // NGN | USD | GBP | EUR | GHS | KES | ZAR | CAD | AUD | INR
  amount    Float
  status    String    @default("PENDING")
  provider  String    @default("MANUAL")
  reference String?
  note      String?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
