# ─────────────────────────────────────────────────────────────────────────────
# DeeYoung Pro (DeeYoung) — Environment Variables
# Copy to .env locally; set these in Railway → Variables for production.
# NEVER commit the real .env to Git. Rotate any secret that touches a chat/ticket.
# ─────────────────────────────────────────────────────────────────────────────

# Database — SQLite locally; Supabase Postgres in production (prisma/schema.postgres.prisma).
# Local:     DATABASE_URL="file:./db/custom.db"
# Supabase:  DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
#            (URL-encode special chars in the password: @ → %40, & → %26, $ → %24)
# The app picks the right Prisma dialect automatically from this URL.
# Railway builds/starts against schema.postgres.prisma (see railway.json).
DATABASE_URL="file:./db/custom.db"

# Better Auth — 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-a-real-one"
# Public URL of the deployed app (no trailing slash). Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# HMAC salt for hashing signup IPs (GDPR-safe velocity checks). Generate like above.
APP_SECRET="change-me-generate-a-real-one"

# Comma-separated emails that become ADMIN on signup (moderation panel).
ADMIN_EMAILS="you@example.com"

# ── Transactional email (Resend) — verification & password reset ────────────
# When RESEND_API_KEY is SET: email verification becomes REQUIRED (production-strict)
# and branded verification / password-reset mails are sent.
# When UNSET (local/sandbox): verification is skipped and links are printed to the
# server console instead — the full flow stays testable without outbound mail.
# RESEND_API_KEY="re_..."
# Sender identity. Use a domain you verified in Resend (SPF/DKIM), e.g.:
# EMAIL_FROM="DeeYoung <no-reply@yourdomain.com>"
# Unset → falls back to Resend's sandbox sender (delivers only to your own inbox).

# ── Optional hardening (recommended before public launch) ────────────────────
# Cloudflare Turnstile (free bot protection on signup):
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# PostHog product analytics (free tier: us.i.posthog.com or eu.i.posthog.com):
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Payments (Paystack) — wire up when business verification completes ──────
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
