# ─────────────────────────────────────────────────────────────────────────────
# DeeYoung Pro (DeeYoung) — Environment Variables
# Copy to .env locally; set these in Railway → Variables for production.
# NEVER commit the real .env to Git. Rotate any secret that touches a chat/ticket.
# ─────────────────────────────────────────────────────────────────────────────

# Database — SQLite locally; Supabase Postgres in production (prisma/schema.postgres.prisma).
# Local:     DATABASE_URL="file:./db/custom.db"
# Supabase:  DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"
#            (URL-encode special chars in the password: @ → %40, & → %26, $ → %24)
# The app picks the right Prisma dialect automatically from this URL.
# Railway builds/starts against schema.postgres.prisma (see railway.json).
DATABASE_URL="file:./db/custom.db"

# Better Auth — 32+ random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-a-real-one"
# Public URL of the deployed app (no trailing slash). Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# HMAC salt for hashing signup IPs (GDPR-safe velocity checks). Generate like above.
APP_SECRET="change-me-generate-a-real-one"

# Comma-separated emails that become ADMIN on signup (moderation panel).
ADMIN_EMAILS="you@example.com"

# ── Transactional email — transport chain: Resend → AgentMail → dry mode ────
# 1) RESEND_API_KEY (preferred in production — your verified domain sender):
#    When SET, email verification becomes REQUIRED and branded verification /
#    password-reset mails are sent via Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="DeeYoung <no-reply@yourdomain.com>"   # domain verified in Resend
# 2) AGENTMAIL_API_KEY (agentmail.to) — used when RESEND is unset:
#    branded mail goes out from your AgentMail org inbox. Verification becomes
#    required the same way. Get a key at agentmail.to (free tier available).
# AGENTMAIL_API_KEY="am_us_..."
# AGENTMAIL_INBOX="deyoungsltd@agentmail.to"        # default: first org inbox
# 3) Neither set → dry mode: verification is skipped and links print to the
#    server console — the full flow stays testable without outbound mail.

# ── Optional hardening (recommended before public launch) ────────────────────
# Cloudflare Turnstile (free bot protection on signup):
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# PostHog product analytics (free tier: us.i.posthog.com or eu.i.posthog.com):
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Payments (Paystack) — wire up when business verification completes ──────
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
# Broker bridge (MT4/MT5 via MetaApi) — optional
# METAAPI_TOKEN=
# Extra origins allowed to POST auth requests (wildcards OK)
# TRUSTED_ORIGINS=

# ── Bybit demo-trading bridge (PRIMARY venue since 2026-09-04) ────────────────
# Generate keys while your Bybit web session is in Demo Trading mode.
# Permissions: Read + Contract. Works with a $0 balance (simulated funds).
BYBIT_API_KEY=
BYBIT_API_SECRET=
# demo (default, simulated funds + production data) | testnet | live
BYBIT_ENV=demo

# ── OANDA bridge (DORMANT — not available to Nigerian residents) ──────────────
# OANDA_TOKEN=
# OANDA_ACCOUNT_ID=
